# 公证配置说明（只含占位值，禁止复制到仓库内作为真实配置）
# 首选：用户本人在终端交互执行 xcrun notarytool store-credentials atlas-notary
# 构建：APPLE_KEYCHAIN_PROFILE=atlas-notary npm run app:build
# DMG：xcrun notarytool submit dist-app/Atlas-mac-arm64.dmg --keychain-profile atlas-notary --wait
# 不要将新密码写进仓库、聊天或命令行；不要同时设置 profile 与下面的环境变量。
# 环境变量退路仅在仓库外 ~/.config/atlas/notarize.env 使用（目录 0700 / 文件 0600）。
# 由用户本人在终端编辑；CI 使用 GitHub Actions secrets，不落盘。
export APPLE_ID="you@example.invalid"
export APPLE_APP_SPECIFIC_PASSWORD="REPLACE_IN_YOUR_OWN_TERMINAL"
export APPLE_TEAM_ID="YOUR_TEAM_ID"
