# Atlas 桌面 App 签名 + 公证凭据（模板）
#
# 用法：
#   1) 复制本文件为同目录下的 notarize.env（已被 .gitignore 忽略，不会进 git）
#        cp electron/build/notarize.env.example electron/build/notarize.env
#   2) 填入下面三个值（APPLE_TEAM_ID 已按你钥匙串里的 Developer ID 证书预填）
#   3) 构建：
#        source electron/build/notarize.env && npm run app:build
#
# ⚠️ App 专用密码是机密：只写进本机的 notarize.env（gitignored），不要提交、不要贴到任何地方。

# 你的 Apple ID 邮箱
export APPLE_ID="you@example.com"

# 在 https://appleid.apple.com → 登录与安全 → App 专用密码 生成，形如 xxxx-xxxx-xxxx-xxxx
export APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# 你的 Team ID（10 位）—— 已从钥匙串里的 "Developer ID Application: Damon Wang (MA5G62M45A)" 读到
export APPLE_TEAM_ID="MA5G62M45A"
